# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Project URL from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# SUPABASE_ANON_KEY: Publishable anon key from Supabase Dashboard -> Project Settings -> API
SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"
VITE_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: Secret service role key (server-side only, used for Admin User Management & Hard Delete)
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# DATABASE_URL / SUPABASE_DB_URL: Optional direct PostgreSQL connection string from Supabase Settings -> Database
# If provided, the server automatically applies supabase/schema.sql on startup.
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
